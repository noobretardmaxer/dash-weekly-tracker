generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core / cross-cutting
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  member
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  initials  String
  role      UserRole @default(member)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedRedditMentions RedditMention[]
  resolvedAlerts      Alert[]
  updatedSettings     Setting[]

  @@map("users")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

enum JobStatus {
  success
  failure
  running
}

model Job {
  id             String    @id @default(uuid())
  name           String    @unique
  cronExpr       String
  enabled        Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastDurationMs Int?
  lastStatus     JobStatus?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  syncLogs SyncLog[]

  @@map("jobs")
}

enum SyncStatus {
  success
  failure
  partial
}

enum IntegrationName {
  posthog
  gsc
  semrush
  twitter
  discord
  reddit
  blog
  social
}

model SyncLog {
  id               String          @id @default(uuid())
  jobId            String?
  job              Job?            @relation(fields: [jobId], references: [id])
  integration      IntegrationName
  requestId        String
  startedAt        DateTime
  finishedAt       DateTime?
  durationMs       Int?
  status           SyncStatus
  recordsProcessed Int?
  errorMessage     String?
  createdAt        DateTime        @default(now())

  @@index([integration, startedAt])
  @@map("sync_logs")
}

enum AlertType {
  traffic_drop
  keyword_drop
  backlinks_lost
  activation_drop
  signups_drop
  mention_spike
  sync_failure
}

enum AlertSeverity {
  info
  warning
  critical
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

model Alert {
  id             String        @id @default(uuid())
  type           AlertType
  severity       AlertSeverity
  title          String
  message        String
  metricSource   String
  currentValue   Float
  previousValue  Float
  deltaPct       Float
  status         AlertStatus   @default(open)
  resolvedById   String?
  resolvedBy     User?         @relation(fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([type])
  @@map("alerts")
}

enum ReportStatus {
  Ready
  Generating
  Failed
}

model Report {
  id          String       @id @default(uuid())
  name        String
  type        String
  status      ReportStatus @default(Generating)
  periodStart DateTime
  periodEnd   DateTime
  payload     Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([createdAt])
  @@index([type])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Domain metrics — one row per day unless noted
// ---------------------------------------------------------------------------

model WebsiteMetric {
  id                    String   @id @default(uuid())
  date                  DateTime @db.Date
  visitors              Int
  uniqueVisitors        Int
  returningVisitors     Int
  signups               Int
  activationRate        Float
  avgSessionDurationSec Int
  bounceRate            Float
  trafficSources        Json
  deviceBreakdown       Json
  countryBreakdown      Json
  topLandingPages       Json
  topExitPages          Json
  activationFunnel      Json
  conversionFunnel      Json
  source                String   @default("mock")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("website_metrics")
}

model SearchConsoleMetric {
  id               String   @id @default(uuid())
  date             DateTime @db.Date
  clicks           Int
  impressions      Int
  ctr              Float
  avgPosition      Float
  topQueries       Json
  topPages         Json
  countries        Json
  devices          Json
  searchAppearance Json
  source           String   @default("mock")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("search_console_metrics")
}

model SeoMetric {
  id                     String   @id @default(uuid())
  date                   DateTime @db.Date
  organicTraffic         Int
  organicKeywords        Int
  domainRating           Float
  backlinks              Int
  referringDomains       Int
  newBacklinks           Int
  lostBacklinks          Int
  topPages               Json
  fastestGrowingKeywords Json
  losingKeywords         Json
  refDomainsByAuthority  Json     @default("[]")
  topRefDomains          Json     @default("[]")
  topAnchors             Json     @default("[]")
  topTlds                Json     @default("[]")
  source                 String   @default("mock")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("seo_metrics")
}

model TwitterMetric {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  followers       Int
  newFollowers    Int
  mentions        Int
  profileVisits   Int
  engagementRate  Float
  linkClicks      Int
  topTweets       Json
  source          String   @default("mock")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("twitter_metrics")
}

model DiscordMetric {
  id                String   @id @default(uuid())
  date              DateTime @db.Date
  memberCount       Int
  dau               Int
  wau               Int
  messages          Int
  topChannels       Json
  mostActiveMembers Json
  source            String   @default("mock")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("discord_metrics")
}

enum RedditSentiment {
  Positive
  Neutral
  Negative
}

enum RedditMentionType {
  Question
  Complaint
  Comparison
  Praise
  BugReport
  FeatureRequest
}

enum RedditPriority {
  Low
  Medium
  High
  Critical
}

enum RedditStatus {
  New
  InProgress
  Responded
  Resolved
  Ignored
}

model RedditMention {
  id             String            @id @default(uuid())
  subreddit      String
  postTitle      String
  author         String
  url            String
  score          Int
  comments       Int
  sentiment      RedditSentiment
  mentionType    RedditMentionType
  priority       RedditPriority
  status         RedditStatus      @default(New)
  ownerId        String?
  owner          User?             @relation(fields: [ownerId], references: [id])
  fullPost       String
  topComments    Json
  aiSummary      String
  suggestedReply String
  statusTimeline Json
  matchedKeyword String
  mentionedAt    DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([url])
  @@index([subreddit, mentionedAt])
  @@index([status])
  @@index([priority])
  @@map("reddit_mentions")
}

model BlogMetric {
  id                 String   @id @default(uuid())
  date               DateTime @db.Date
  blogsPublished      Int
  blogVisitors       Int
  avgReadingTimeSec  Int
  contentConversions Int
  topCategories      Json
  source             String   @default("mock")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("blog_metrics")
}

model BlogPost {
  id            String   @id @default(uuid())
  title         String
  slug          String
  category      String
  visitors      Int
  timeOnPageSec Int
  ctr           Float
  conversions   Int
  capturedAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([slug, capturedAt])
  @@index([capturedAt])
  @@map("blog_posts")
}

model KeywordRanking {
  id               String   @id @default(uuid())
  keyword          String
  currentPosition  Int
  previousPosition Int
  movement         Int
  searchVolume     Int
  difficulty       Int
  clicks           Int
  ctr              Float
  landingPage      String
  checkedAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([keyword, checkedAt])
  @@index([currentPosition])
  @@map("keyword_rankings")
}

enum SocialPlatform {
  twitter
  linkedin
  instagram
  youtube
}

model Creator {
  id        String   @id @default(uuid())
  name      String
  handle    String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts SocialPost[]

  @@unique([handle])
  @@map("creators")
}

model SocialPost {
  id          String         @id @default(uuid())
  creatorId   String
  creator     Creator        @relation(fields: [creatorId], references: [id])
  platform    SocialPlatform
  content     String
  url         String
  publishedAt DateTime
  likes       Int
  comments    Int
  shares      Int
  impressions Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([url])
  @@index([publishedAt])
  @@index([creatorId])
  @@index([platform])
  @@map("social_posts")
}

model CompetitorMetric {
  id               String   @id @default(uuid())
  competitorDomain String
  date             DateTime @db.Date
  organicTraffic   Int
  organicKeywords  Int
  domainRating     Float
  backlinks        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([competitorDomain, date])
  @@map("competitor_metrics")
}

// ---------------------------------------------------------------------------
// Google Search Console pipeline (Phase 2)
//
// Design notes:
// - Property-scoped: every row carries propertyId so the UI property switcher
//   (sc-domain:hydradb.com vs https://hydradb.com/) is a real filter, not a hack.
// - searchType lives on every metric row from day one (only 'web' is synced
//   initially) so adding Image/Video/News/Discover never needs a re-backfill.
// - String columns (not Postgres enums) for type/searchType/dimension/status/
//   errorCode/dataState: this repo has hit enum-migration breakage before, and
//   these evolve; allowed values are enforced in code (zod + TS unions).
// - ctr is stored as the RAW fraction (0..1) exactly as GSC returns it; position
//   as returned. Range rollups are recomputed (CTR = Σclicks/Σimpressions,
//   position = impression-weighted mean) in the read layer — never averaged.
// - dimensionValue / url can be long (page URLs); their uniqueness keys use an
//   md5 hash column to stay under Postgres' btree index row-size limit.
// - These tables run ALONGSIDE the legacy search_console_metrics table until the
//   two readers (search-console + dashboard routes) are migrated in Phase 3.
// ---------------------------------------------------------------------------

model GscProperty {
  id              String   @id @default(uuid())
  siteUrl         String   @unique // 'sc-domain:hydradb.com' | 'https://hydradb.com/'
  type            String // 'domain' | 'url_prefix'
  displayName     String
  permissionLevel String? // from sites.list (siteFullUser, siteOwner, ...)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dailyTotals    GscDailyTotal[]
  dimensionDaily GscDimensionDaily[]
  syncRuns       GscSyncRun[]
  sitemaps       GscSitemap[]
  urlIndexStatus GscUrlIndexStatus[]

  @@map("gsc_properties")
}

model GscSyncRun {
  id             String      @id @default(uuid())
  propertyId     String
  property       GscProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  jobType        String // 'backfill' | 'daily' | 'inspect' | 'crux' | 'sitemaps'
  status         String // 'running' | 'success' | 'partial' | 'failed'
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?
  rowsWritten    Int         @default(0)
  dateRangeStart DateTime?   @db.Date
  dateRangeEnd   DateTime?   @db.Date
  cursor         Json? // checkpoint for resumable backfill (dimension + startRow + last completed date)
  errorCode      String? // GscErrorCode
  errorMessage   String?
  retryCount     Int         @default(0)
  createdAt      DateTime    @default(now())

  @@index([propertyId, jobType, startedAt])
  @@index([jobType, startedAt])
  @@map("gsc_sync_runs")
}

model GscDailyTotal {
  propertyId  String
  property    GscProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  searchType  String // 'web' | 'image' | 'video' | 'news' | 'discover'
  clicks      Int
  impressions Int
  ctr         Float // raw fraction 0..1 as returned
  position    Float
  dataState   String      @default("final") // 'final' | 'provisional'
  updatedAt   DateTime    @updatedAt

  @@id([propertyId, date, searchType])
  @@index([propertyId, searchType, date])
  @@map("gsc_daily_totals")
}

model GscDimensionDaily {
  propertyId         String
  property           GscProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date               DateTime    @db.Date
  searchType         String
  dimension          String // 'query' | 'page' | 'country' | 'device' | 'search_appearance'
  dimensionValue     String
  dimensionValueHash String // md5(dimensionValue) — bounds the PK/index size for long URLs
  clicks             Int
  impressions        Int
  ctr                Float
  position           Float
  dataState          String      @default("final")
  updatedAt          DateTime    @updatedAt

  @@id([propertyId, date, searchType, dimension, dimensionValueHash])
  @@index([propertyId, dimension, date])
  @@index([propertyId, dimension, searchType, date])
  @@map("gsc_dimension_daily")
}

model GscSitemap {
  id              String      @id @default(uuid())
  propertyId      String
  property        GscProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  path            String
  lastSubmitted   DateTime?
  lastDownloaded  DateTime?
  isPending       Boolean     @default(false)
  isSitemapsIndex Boolean     @default(false)
  type            String?
  warnings        Int         @default(0)
  errors          Int         @default(0)
  submittedUrls   Int         @default(0)
  indexedUrls     Int         @default(0)
  updatedAt       DateTime    @updatedAt

  @@unique([propertyId, path])
  @@map("gsc_sitemaps")
}

model GscUrlIndexStatus {
  id              String      @id @default(uuid())
  propertyId      String
  property        GscProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url             String
  urlHash         String // md5(url) — bounds the uniqueness index size
  verdict         String? // PASS | PARTIAL | FAIL | NEUTRAL
  coverageState   String? // 'Submitted and indexed', 'Crawled - currently not indexed', 'Not found (404)', ...
  robotsTxtState  String?
  indexingState   String?
  pageFetchState  String?
  googleCanonical String?
  userCanonical   String?
  lastCrawlTime   DateTime?
  crawledAs       String?
  isHttps         Boolean?
  inspectedAt     DateTime    @default(now())

  @@unique([propertyId, urlHash])
  @@index([propertyId, coverageState])
  @@map("gsc_url_index_status")
}

model CruxDaily {
  id          String   @id @default(uuid())
  originOrUrl String
  scope       String // 'origin' | 'url'
  formFactor  String // 'phone' | 'desktop'
  date        DateTime @db.Date
  lcpP75      Float?
  inpP75      Float?
  clsP75      Float?
  ttfbP75     Float?
  bucket      String? // 'good' | 'needs_improvement' | 'poor'
  updatedAt   DateTime @updatedAt

  @@unique([originOrUrl, formFactor, date])
  @@index([formFactor, date])
  @@map("crux_daily")
}
