# ---- General ----
PORT=4000
NODE_ENV=development
# Master switch: when true, every integration uses generated fixture data instead of
# calling the real third-party API. Individual integrations can still be forced into
# mock mode independently below even if MOCK_MODE=false.
MOCK_MODE=true

# Ports below (5433/6380) match `docker compose up -d postgres redis` from the repo root,
# which publishes those services on non-default host ports to avoid clashing with any
# Postgres/Redis already running locally. Adjust if you're running your own instances.
# NOTE: managed Redis (e.g. Upstash) requires TLS — use the rediss:// scheme in
# production, or ioredis/BullMQ can't connect and the worker never runs (which
# leaves every panel blank). The server warns at boot if this looks wrong.
DATABASE_URL=postgresql://hydradb:hydradb@localhost:5433/hydradb_growth?schema=public
REDIS_URL=redis://localhost:6380

# bullmq (default, self-hosted) or trigger (Trigger.dev cloud)
SCHEDULER_DRIVER=bullmq

# When true (default), the worker runs a one-off historical backfill of every
# integration on startup. Cron jobs otherwise only fire at the next tick, so a
# fresh deploy shows no data until then. Set false once history exists to avoid
# re-backfilling on every restart.
BACKFILL_ON_STARTUP=true

# ---- Alerting ----
# Optional Discord/Slack incoming-webhook URL. When set, a message is posted
# whenever an integration sync fails (in addition to the in-app alert). Blank = off.
ALERT_WEBHOOK_URL=

# ---- PostHog ----
# Personal API key: https://us.posthog.com/settings/user-api-keys (read scope is enough)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
POSTHOG_MOCK_MODE=

# ---- Google Search Console ----
# Create a service account in Google Cloud Console, enable the Search Console API,
# add the service account email as a "Full" user on the property in Search Console.
GSC_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GSC_MOCK_MODE=

# ---- SEMrush ----
# API key: https://www.semrush.com/api/ (requires a paid SEMrush subscription with API add-on)
# SEO is real-data-only: there is NO mock client. With no key the sync is skipped and the
# SEO dashboard shows honest empty states (never fabricated numbers). Diagnose with
# `npm run semrush:doctor`. (No SEMRUSH_MOCK_MODE — mock SEO data is forbidden.)
SEMRUSH_API_KEY=
SEMRUSH_TARGET=hydradb.com
SEMRUSH_DATABASE=us

# ---- Twitter / X ----
# App-only bearer token from the X Developer Portal (Essential/Basic tier)
TWITTER_BEARER_TOKEN=
TWITTER_USERNAME=hydradb
TWITTER_MOCK_MODE=

# ---- Discord ----
# Bot token from the Discord Developer Portal; bot must be invited to the guild with
# the "Server Members Intent" enabled and View Channels / Read Message History permissions.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MOCK_MODE=

# ---- Reddit ----
# Script-type app OAuth2 credentials: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=hydradb-growth-dashboard/0.1 (by /u/your-username)
REDDIT_MOCK_MODE=

# ---- Content (blog) & Social Leaderboard ----
# No environment needed: these have no real third-party source yet and always use
# generated fixture data. They still run as scheduled jobs (and report through
# /admin/sync/status) so their panels populate in production — swap in a real
# source later (e.g. PostHog /blog/* pageviews, per-platform social APIs) without
# changing the scheduler/seed wiring.

# ---- Trigger.dev (optional, only used when SCHEDULER_DRIVER=trigger) ----
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev
