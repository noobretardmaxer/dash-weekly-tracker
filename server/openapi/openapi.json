  "paths": {
    "/api/v1/dashboard": {
      "get": {
        "description": "Composite overview / list endpoint for the dashboard domain. Supports date-range (`days` or `from`/`to`), comparison (`compare`), and — where the endpoint is a list — pagination, sorting, and filtering query params.",
        "summary": "Get dashboard data",
        "tags": [
          "dashboard"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "nullable": true
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "nullable": true
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            },
            "required": false,
            "name": "days",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "none",
                "previous_period",
                "previous_year"
              ],
              "default": "previous_period"
            },
            "required": false,
            "name": "compare",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
